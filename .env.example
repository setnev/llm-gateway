# LLM Gateway — Environment Configuration
# Copy to .env and fill in values before running

# Server
PORT=8080
NODE_ENV=development

# Config files (relative to project root)
TENANT_CONFIG_PATH=./config/tenants.json
POLICY_CONFIG_PATH=./config/policies.json

# Admin API (minimum 32 characters)
ADMIN_API_KEY=change-me-to-something-secure-32chars

# Redis (optional — falls back to in-memory if not set)
# REDIS_URL=redis://localhost:6379

# Anomaly Detection Webhooks (optional)
# ALERT_WEBHOOK_URL=https://your-alerting-endpoint.com/webhook
# ALERT_WEBHOOK_SECRET=your-webhook-signing-secret

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=llm-gateway

# Rate Limiting Defaults (per-tenant config overrides these)
DEFAULT_RPM=60
DEFAULT_DAILY_CAP_USD=10
